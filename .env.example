PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve
REDIS_URL=redis://localhost:6379
# Leave empty locally for dev defaults; production and compose need 32+ chars (openssl rand -hex 32)
JWT_SECRET=
WEBHOOK_SECRET=
JWT_EXPIRES_IN=1h
WEBHOOK_TOLERANCE_SEC=300
LOG_LEVEL=info
# Behind a reverse proxy, the number of proxy hops to trust, so rate limits see client IPs
# TRUST_PROXY=1
# Optional overrides for `npm run seed` (the password is required when NODE_ENV=production)
# SEED_ADMIN_EMAIL=admin@eve.local
# SEED_ADMIN_PASSWORD=
