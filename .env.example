PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eve
REDIS_URL=redis://localhost:6379
# Empty secrets fall back to dev defaults locally. Production and docker compose require
# real ones of 32+ characters: openssl rand -hex 32
JWT_SECRET=
WEBHOOK_SECRET=
JWT_EXPIRES_IN=1h
WEBHOOK_TOLERANCE_SEC=300
LOG_LEVEL=info
# Optional overrides for `npm run seed` (the password is required when NODE_ENV=production)
# SEED_ADMIN_EMAIL=admin@eve.local
# SEED_ADMIN_PASSWORD=
